{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testTimeout": 30000,
  "setupFiles": ["<rootDir>/e2e-db.setup.ts"],
  "testMatch": [
    "<rootDir>/app.e2e-spec.ts",
    "<rootDir>/assignments.e2e-spec.ts",
    "<rootDir>/academic-access.e2e-spec.ts",
    "<rootDir>/courses.e2e-spec.ts",
    "<rootDir>/electives.e2e-spec.ts",
    "<rootDir>/grades.e2e-spec.ts",
    "<rootDir>/identity.e2e-spec.ts",
    "<rootDir>/materials.e2e-spec.ts",
    "<rootDir>/references.e2e-spec.ts",
    "<rootDir>/reports.e2e-spec.ts",
    "<rootDir>/schedule.e2e-spec.ts",
    "<rootDir>/surveys.e2e-spec.ts"
  ],
  "detectOpenHandles": true,
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  }
}
